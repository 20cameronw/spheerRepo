<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Frontier.Core compiled outside Unity, exactly as Unity compiles it: netstandard 2.1, C# 9, warnings are errors.
    The sources are LINKED from the Unity project (SpheerURP/Assets/Frontier/Scripts/Core); nothing is copied.
    This project is not part of the Unity project (it lives in tests/ at the repository root, which Unity never imports).
    Paths use forward slashes so the same file builds on Windows, Linux and macOS.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Frontier.Core</AssemblyName>
    <RootNamespace>Frontier</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../SpheerURP/Assets/Frontier/Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
