      m_Items: []
  - m_Id: 1991336038
    m_Localized: 'Backpack full - lost:'
    m_Metadata:
      m_Items: []
  - m_Id: 1991336039
    m_Localized: The aliens broke through. No salvage this time.
    m_Metadata:
      m_Items: []
  - m_Id: 1991336040
    m_Localized: SKIP
