    m_Metadata:
      m_Items: []
  - m_Id: 1991336049
    m_Localized: 'Drag to steer and line up your shots. Bullets fly straight.

      Dodge
      the warning shapes. BOMB launches forward to the guardian line before exploding.'
    m_Metadata:
      m_Items: []
  - m_Id: 1991336050
    m_Localized: GUARDIAN APPROACHING
    m_Metadata:
      m_Items: []
