  m_Name: ObjectiveCatalog
  entries:
  - id: first_structure
    title: Make landfall yours
    description: Complete your first structure. Construction must finish before it counts.
    metric: 1
    target: 1
    route: 1
  - id: first_harvest
    title: First haul
    description: Complete and collect a harvest run. Abandoned runs do not count.
    metric: 0
    target: 1
    route: 0
  - id: first_warehouse
    title: Room to grow
    description: Complete a Warehouse to store resources beyond your backpack.
    metric: 2
    targetId: warehouse
    target: 1
    route: 1
  - id: first_fuel
    title: Fuel the frontier
    description: Craft fuel at a processing station. Found or starting fuel does not count.
    metric: 3
    targetId: fuel
    target: 1
    route: 4
  - id: first_hop
    title: Leave the cradle
    description: Land on a second distinct world.
    metric: 4
    target: 2
    route: 2
  - id: first_wave
    title: Hold your ground
    description: Call and clear an alien wave on your planet.
    metric: 5
    target: 1
    route: 1
  - id: research_lab
    title: A place for discovery
    description: Complete a Research Lab to unlock advanced technology.
    metric: 2
    targetId: research_lab
    target: 1
    route: 1
  - id: jump_range_1
    title: A longer reach
    description: Purchase the first Jump Range upgrade to reach more distant worlds.
    metric: 6
    targetId: jump
    target: 1
    route: 5
