/* All sizes are logical pixels. The panel scales so the shorter screen side is always ~1080 logical px,
   which keeps every layout below identical in proportion on any device or orientation. */

.fr-root {
    flex-grow: 1;
    color: rgb(220, 245, 255);
    font-size: 28px;
    -unity-font-style: bold;
}

.fr-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.fr-small { font-size: 24px; margin-left: 6px; }
.fr-tiny { font-size: 20px; color: rgba(190, 220, 240, 0.7); -unity-font-style: normal; white-space: normal; }
.fr-title { font-size: 44px; letter-spacing: 3px; }
.fr-h2 { font-size: 30px; white-space: normal; }
.fr-muted { color: rgba(190, 220, 240, 0.65); -unity-font-style: normal; font-size: 24px; white-space: normal; }

.fr-row { flex-direction: row; align-items: center; }
.fr-row-wrap { flex-direction: row; flex-wrap: wrap; align-items: center; }
.fr-spacer { flex-grow: 1; }
.fr-icon { width: 40px; height: 40px; flex-shrink: 0; }

/* ---------- HUD ---------- */
.fr-topbar { position: absolute; left: 0; right: 0; top: 0; height: 120px; }
.fr-topbar-bar {
    position: absolute; left: 24px; right: 24px; top: 14px; height: 84px;
    flex-direction: row; align-items: center; justify-content: space-between;
    padding: 0 32px;
    border-radius: 42px; border-width: 2px;
    background-color: rgba(5, 9, 28, 0.88);
}
.fr-chip {
    flex-direction: row; align-items: center;
    margin-left: 22px; flex-shrink: 0;
}
.fr-chip .fr-icon { width: 36px; height: 36px; margin-right: 10px; flex-shrink: 0; }
.fr-chip-text { font-size: 28px; }
.fr-chip-xp { width: 110px; margin-left: 10px; }
.fr-planet-name { font-size: 26px; flex-grow: 1; flex-shrink: 1; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; }
.fr-bar {
    height: 16px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.55);
    overflow: hidden;
    margin-top: 6px;
}
.fr-bar-fill { height: 100%; border-radius: 8px; }

.fr-dock {
    position: absolute; left: 0; right: 0; bottom: 20px;
    flex-direction: row; justify-content: space-evenly; align-items: center;
}
.fr-round { width: 140px; height: 140px; border-radius: 70px; }
.fr-btn .fr-icon { flex-shrink: 0; }
.fr-btn { flex-direction: row; align-items: center; justify-content: center; }

.fr-iconbtn {
    width: 128px; height: 128px;
    margin: 0; padding: 0;
    border-radius: 34px;
    align-items: center; justify-content: center;
    transition-property: scale;
    transition-duration: 0.1s;
}
.fr-iconbtn:hover { scale: 1.06 1.06; }
.fr-iconbtn:active { scale: 0.94 0.94; }
.fr-iconbtn-icon { width: 70%; height: 70%; }
.fr-iconbtn-small { width: 84px; height: 84px; border-radius: 24px; }

/* ---------- Modals ---------- */
.fr-backdrop {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(2, 3, 14, 0.62);
    align-items: center; justify-content: center;
    padding: 24px;
}
.fr-modal {
    flex-direction: column;
    min-width: 560px; max-width: 96%; max-height: 92%;
    border-radius: 30px; border-width: 3px;
    background-color: rgba(4, 7, 24, 0.96);
    padding: 18px 22px 22px 22px;
}
.fr-modal-wide { width: 940px; }
.fr-modal-head { flex-direction: row; align-items: center; margin-bottom: 12px; flex-shrink: 0; }
.fr-modal-title { font-size: 36px; margin-left: 12px; flex-grow: 1; }
.fr-modal-scroll { flex-shrink: 1; flex-grow: 0; }
.fr-tabs { flex-direction: row; margin-bottom: 12px; flex-shrink: 0; }
.fr-tab {
    flex-grow: 1; margin: 0 6px 0 0; padding: 10px 6px;
    border-radius: 18px; border-width: 2px;
    flex-direction: row; justify-content: center; align-items: center;
    background-color: rgba(10, 16, 40, 0.9);
}

/* ---------- Cards / buttons ---------- */
.fr-card {
    flex-direction: column;
    padding: 14px 18px;
    margin-bottom: 12px;
    border-radius: 22px;
    border-width: 2px; border-color: rgba(26, 242, 255, 0.5);
    background-color: rgba(10, 18, 44, 0.92);
}

.fr-btn {
    margin: 0; margin-top: 8px;
    padding: 12px 22px;
    border-radius: 18px;
    font-size: 26px;
    -unity-font-style: bold;
    flex-direction: row; align-items: center; justify-content: center;
    transition-property: scale;
    transition-duration: 0.1s;
}
.fr-btn:hover { scale: 1.04 1.04; }
.fr-btn:active { scale: 0.96 0.96; }
.fr-btn-big { font-size: 36px; padding: 20px 36px; border-radius: 26px; }
.fr-btn-mini { margin-top: 0; margin-left: 8px; padding: 8px 16px; font-size: 24px; border-radius: 14px; }

.fr-itemchip {
    flex-direction: row; align-items: center;
    padding: 3px 12px 3px 6px; margin: 3px 8px 3px 0;
    border-radius: 16px; border-width: 2px;
    background-color: rgba(0, 0, 0, 0.45);
}
.fr-itemchip .fr-icon { width: 30px; height: 30px; margin-right: 4px; }
.fr-dot { width: 18px; height: 18px; border-radius: 9px; }

/* ---------- Backpack (Minecraft style grid) ---------- */
.fr-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.fr-slot {
    margin: 0;
    border-width: 2px; border-color: rgba(120, 160, 200, 0.28);
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center; justify-content: center;
}
.fr-slot-locked { opacity: 0.3; }
.fr-slot .fr-icon { width: 62%; height: 62%; }
.fr-slot-count { position: absolute; right: 4px; bottom: 0; font-size: 22px; }
.fr-drag-ghost {
    position: absolute; width: 56px; height: 56px; opacity: 1;
    align-items: center; justify-content: center;
    background-color: rgb(22, 29, 43);
    border-radius: 12px; border-width: 2px; border-color: rgb(190, 218, 238);
}
.fr-drag-count { position: absolute; right: 2px; bottom: 0; font-size: 16px; color: white; }

/* ---------- Menu / settings ---------- */
.fr-menu-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.fr-menu-tile {
    width: 30%; min-width: 200px; margin: 8px 1.5%; padding: 20px 8px;
    border-radius: 24px; border-width: 2px;
    flex-direction: column; align-items: center;
    background-color: rgba(10, 18, 44, 0.92);
}
.fr-menu-tile .fr-icon { width: 80px; height: 80px; margin-bottom: 8px; }
.fr-slider { flex-grow: 1; min-height: 54px; margin: 0 8px; }
.fr-setting-row { flex-direction: row; align-items: center; margin: 10px 0; }
.fr-setting-row > Label { min-width: 200px; }
.fr-back { align-self: flex-start; margin-bottom: 8px; }

/* ---------- World popups ---------- */
.fr-popup {
    position: absolute;
    flex-direction: column;
    min-width: 480px; max-width: 780px; max-height: 78%;
    padding: 20px 24px 22px 24px;
    border-radius: 30px; border-width: 3px;
    background-color: rgba(4, 7, 24, 0.96);
}
.fr-popup-scroll { flex-shrink: 1; }
.fr-popup-close { position: absolute; top: 14px; right: 14px; }
.fr-popup-head { padding-right: 70px; margin-bottom: 8px; }
.fr-popup .fr-tiny { font-size: 24px; }
.fr-popup .fr-small { font-size: 28px; }
.fr-popup .fr-h2 { font-size: 34px; }
.fr-popup .fr-btn { font-size: 28px; padding: 14px 26px; }
.fr-popup .fr-itemchip { padding: 6px 16px 6px 8px; margin: 4px 10px 4px 0; border-radius: 20px; }
.fr-popup .fr-itemchip .fr-icon { width: 40px; height: 40px; margin-right: 8px; }
.fr-popup-section {
    font-size: 22px; letter-spacing: 2px; margin-top: 14px; margin-bottom: 6px;
    color: rgba(140, 220, 255, 0.85);
}
.fr-popup-line {
    margin-top: 8px; padding: 10px 14px;
    border-radius: 18px; background-color: rgba(255, 255, 255, 0.05);
}
.fr-recipe { margin-top: 10px; margin-bottom: 0; }
.fr-recipe-flow { flex-direction: row; align-items: center; }
.fr-recipe-side {
    flex-basis: 0; flex-grow: 1; flex-shrink: 1; min-width: 0;
    padding: 10px 12px; border-radius: 12px;
    background-color: rgb(38, 41, 48);
}
.fr-recipe-side > .fr-tiny { font-size: 20px; margin-bottom: 6px; color: rgb(201, 212, 225); }
.fr-recipe-arrow { flex-shrink: 0; margin: 0 12px; }
.fr-recipe-resource { flex-direction: row; align-items: center; margin-top: 4px; }
.fr-recipe-resource .fr-icon { margin-right: 8px; }
.fr-recipe-resource .fr-small {
    flex-shrink: 1; min-width: 0; margin-left: 0; font-size: 24px; white-space: normal;
}
.fr-stepper { flex-direction: row; align-items: center; justify-content: center; margin: 6px 0; }
.fr-stepper-val { font-size: 40px; min-width: 90px; -unity-text-align: middle-center; }

.fr-banner {
    position: absolute; left: 0; right: 0; bottom: 190px;
    align-items: center;
}
.fr-banner-box {
    flex-direction: row; align-items: center;
    padding: 10px 14px 10px 26px;
    border-radius: 30px; border-width: 3px;
    background-color: rgba(4, 7, 24, 0.92);
}

/* ---------- Map ---------- */
.fr-map { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(1, 2, 10, 0.97); overflow: hidden; }
.fr-map-world { position: absolute; left: 0; top: 0; width: 1600px; height: 1600px; transform-origin: 0 0; }
.fr-map-node { position: absolute; width: 110px; height: 110px; margin-left: -55px; margin-top: -55px; border-radius: 55px; }
.fr-map-card {
    position: absolute; bottom: 0; align-self: center;
    flex-direction: column;
    min-width: 560px; max-width: 94%;
    padding: 14px 20px 16px 20px; margin-bottom: 16px;
    border-radius: 26px; border-width: 3px;
    background-color: rgba(4, 7, 24, 0.95);
}
.fr-map-tools { position: absolute; right: 16px; top: 16px; flex-direction: column; align-items: flex-end; }
.fr-map-tools .fr-iconbtn { margin-bottom: 10px; }

/* ---------- Overlays / toasts ---------- */
.fr-overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(2, 3, 14, 0.9);
    align-items: center; justify-content: center;
    padding: 30px;
}
.fr-arena {
    width: 100%; flex-grow: 1; margin: 20px 0;
    border-radius: 28px;
    border-width: 3px; border-color: rgba(26, 242, 255, 0.6);
    background-color: rgba(8, 14, 38, 0.9);
    overflow: hidden;
}
.fr-toasts { position: absolute; left: 0; right: 0; top: 210px; align-items: center; }
.fr-toast {
    padding: 10px 26px; margin-bottom: 8px; border-radius: 26px;
    border-width: 2px;
    background-color: rgba(5, 9, 28, 0.92);
}
