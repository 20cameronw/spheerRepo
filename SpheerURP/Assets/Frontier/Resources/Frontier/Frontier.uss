.fr-root {
    flex-grow: 1;
    color: rgb(220, 245, 255);
    font-size: 30px;
    -unity-font-style: bold;
}

.fr-fill {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.fr-small { font-size: 24px; margin-left: 6px; }
.fr-tiny { font-size: 20px; color: rgba(190, 220, 240, 0.7); -unity-font-style: normal; }
.fr-title { font-size: 40px; letter-spacing: 3px; }
.fr-h2 { font-size: 32px; }
.fr-muted { color: rgba(190, 220, 240, 0.65); -unity-font-style: normal; font-size: 24px; white-space: normal; }

.fr-row { flex-direction: row; align-items: center; }
.fr-row-wrap { flex-direction: row; flex-wrap: wrap; align-items: center; }
.fr-spacer { flex-grow: 1; }

/* HUD */
.fr-hud {
    position: absolute; left: 0; top: 0; right: 0;
    padding: 28px 24px 0 24px;
    flex-direction: column;
}
.fr-hud-row { flex-direction: row; justify-content: space-between; align-items: center; }
.fr-chip {
    flex-direction: row; align-items: center;
    padding: 8px 18px;
    border-radius: 28px;
    border-width: 2px; border-color: rgba(26, 242, 255, 0.7);
    background-color: rgba(5, 9, 28, 0.78);
    margin-left: 8px;
}
.fr-planet-tag {
    flex-direction: column;
    padding: 10px 24px;
    border-radius: 22px;
    border-width: 2px; border-color: rgba(255, 64, 242, 0.8);
    background-color: rgba(5, 9, 28, 0.78);
}
.fr-bar {
    height: 18px; width: 150px;
    border-radius: 9px;
    background-color: rgba(0, 0, 0, 0.5);
    overflow: hidden;
    margin-left: 12px;
}
.fr-bar-fill { height: 100%; border-radius: 9px; }

/* Bottom nav */
.fr-nav {
    position: absolute; left: 0; right: 0; bottom: 0;
    flex-direction: row; justify-content: space-around;
    padding: 12px 12px 24px 12px;
    background-color: rgba(3, 5, 18, 0.88);
    border-top-width: 2px; border-top-color: rgba(26, 242, 255, 0.5);
}
.fr-nav-btn {
    flex-grow: 1; margin: 0 6px;
    padding: 14px 4px;
    border-radius: 18px;
    border-width: 2px; border-color: rgba(120, 160, 200, 0.35);
    background-color: rgba(10, 16, 40, 0.9);
    color: rgba(190, 220, 240, 0.8);
    font-size: 26px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}
.fr-nav-btn:hover { scale: 1.05 1.05; }

/* Sheet */
.fr-sheet {
    position: absolute; left: 16px; right: 16px; bottom: 150px;
    height: 52%;
    max-width: 1000px;
    align-self: center;
    border-radius: 28px;
    border-width: 3px; border-color: rgba(26, 242, 255, 0.75);
    background-color: rgba(4, 7, 24, 0.9);
    padding: 22px;
}
.fr-scroll { flex-grow: 1; }

/* Cards */
.fr-card {
    flex-direction: column;
    padding: 18px 22px;
    margin-bottom: 16px;
    border-radius: 22px;
    border-width: 2px; border-color: rgba(26, 242, 255, 0.5);
    background-color: rgba(10, 18, 44, 0.9);
}
.fr-card-active { background-color: rgba(20, 40, 80, 0.95); }

.fr-btn {
    margin: 0; margin-top: 10px;
    padding: 14px 26px;
    border-radius: 18px;
    font-size: 28px;
    -unity-font-style: bold;
    transition-property: scale;
    transition-duration: 0.1s;
}
.fr-btn:hover { scale: 1.04 1.04; }
.fr-btn:active { scale: 0.96 0.96; }
.fr-btn-big { font-size: 40px; padding: 26px 40px; border-radius: 28px; }

.fr-itemchip {
    flex-direction: row; align-items: center;
    padding: 4px 12px 4px 8px; margin: 4px 8px 4px 0;
    border-radius: 16px;
    background-color: rgba(0, 0, 0, 0.45);
}
.fr-dot { width: 18px; height: 18px; border-radius: 9px; }

/* Backpack */
.fr-grid { flex-direction: row; flex-wrap: wrap; }
.fr-slot {
    width: 110px; height: 110px; margin: 6px;
    border-radius: 16px;
    border-width: 2px; border-color: rgba(120, 160, 200, 0.3);
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center; justify-content: center;
}
.fr-slot-count { position: absolute; right: 8px; bottom: 4px; font-size: 24px; }

/* Overlays */
.fr-overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(2, 3, 14, 0.9);
    align-items: center; justify-content: center;
    padding: 40px;
}
.fr-arena {
    width: 100%; flex-grow: 1; margin: 20px 0;
    border-radius: 28px;
    border-width: 3px; border-color: rgba(26, 242, 255, 0.6);
    background-color: rgba(8, 14, 38, 0.9);
    overflow: hidden;
}
.fr-toast {
    position: absolute; top: 230px; align-self: center;
    padding: 14px 30px; border-radius: 26px;
    border-width: 2px;
    background-color: rgba(5, 9, 28, 0.92);
}
