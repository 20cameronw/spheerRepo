    text: Verifying the cloud copy has not changed...
  - key: cloud.restore.changed
    text: The cloud copy changed since comparison. Compare again before restoring.
  - key: cloud.restore-failed
    text: 'Cloud restore failed: {0}'
  - key: cloud.undo.warning
    text: This swaps the current save with the retained device save. Tap again to
      confirm.
